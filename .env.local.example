# Copiar este archivo a .env.local y completar los valores reales.
# Se obtienen desde: Supabase Dashboard > Project Settings > API

# OPCIONAL: "1" fuerza el modo local (sin Supabase) aunque haya claves cargadas.
# Sin este flag, si no existe NEXT_PUBLIC_SUPABASE_URL la app usa automáticamente
# el store local (archivo .data/local-db.json) y queda lista para probar offline.
# LOCAL_MODE=1

# URL del proyecto (ej: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (pública, puede ir al navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (SOLO del lado del servidor, NUNCA exponerla).
# Con ella la app accede a la base de datos (saltea RLS).
# Project Settings > API > service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# --- Chat de dinosaurios (OpenRouter) ---
# Clave de API de OpenRouter (SOLO servidor). Dejarla vacía en este ejemplo;
# poner la real en .env.local. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo a usar. El sufijo :free usa los gratuitos (usan rate-limit).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Proveedor de respaldo (OPCIONAL, gratis): Groq. Se usa cuando OpenRouter
# se satura. https://console.groq.com/keys -> openai/gpt-oss-120b.
# GROQ_API_KEY=

# URL pública del sitio, la manda OpenRouter como HTTP-Referer.
SITE_URL=http://localhost:3000

# --- Notificaciones PWA (Web Push) ---
# Generar claves con: npx web-push generate-vapid-keys
# La pública va al navegador (prefijo NEXT_PUBLIC_); la privada SOLO al servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secreto para proteger las rutas de cron (/api/cron/notify).
# Usar el mismo valor como repo secret "CRON_SECRET" en GitHub (Actions).
CRON_SECRET=